{
	email ai@aurmak.com
	servers {
		# Requests arrive via the Cloudflare proxy, so without this every
		# client looks like a Cloudflare edge IP and client_ip cannot work.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

seo.oryxenlabs.com {
	encode zstd gzip

	# INTERIM GATE. The web tier injects an OWNER-role bearer token
	# server-side, so /pilot and /settings expose full control to any
	# visitor. Remove this block once Cloudflare Access fronts the app.
	# Addresses in OPERATOR_IPS (infra/local/caddy.env, gitignored) skip the
	# gate so the operator's browser is never prompted.
	@protected {
		path /pilot* /settings*
		not client_ip {$OPERATOR_IPS}
	}
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
