{
	# No ACME contact address, deliberately. Caddy registers with the CA
	# anonymously and renewal is automatic either way; what is given up is
	# Let's Encrypt's expiry warning mail, which was going to an address
	# nobody here reads. A failed renewal surfaces as the hourly perimeter
	# check failing on https, not as a message to a person.
	servers {
		# Requests arrive via the Cloudflare proxy, so without this every
		# client looks like a Cloudflare edge IP and client_ip cannot work.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

seo.oryxenlabs.com {
	encode zstd gzip

	# The interim basic-auth gate on /pilot and /settings was removed on
	# 2026-09-08, after sign-in was exercised end to end on this host.
	#
	# It existed for one reason, recorded here because what expired is the
	# reason rather than the caution: the web tier used to inject an
	# OWNER-role bearer token server-side, so reaching /pilot at all was full
	# control of every site. That is no longer how it works. The web tier
	# forwards the signed-in person's own token, the API runs with
	# APP_ENV=production and accepts only a token it can verify against the
	# provider's key set, and proxy.ts sends a request with no session to
	# /login. Authentication is the application's now, which is where it
	# belongs.
	#
	# The gate is not replaced by nothing. check-perimeter.sh still asserts
	# that an anonymous request never reaches the control plane: it now
	# expects a redirect to sign-in rather than a 401, and still fails if
	# either path ever answers 200. That property was always the point;
	# basic_auth was one way of holding it.
	#
	# OPERATOR_IPS is no longer read. Its sense was inverted -- it listed who
	# was *exempt* -- and on 2026-09-07 it held 0.0.0.0/0, which left /pilot
	# serving an OWNER-token session to anyone who asked. Nothing detected
	# it, because every individual piece was correct.

	# The upstreams are named by container, not by compose service, because
	# this container does not sit on only our network. On 2026-09-20 it was
	# also attached to `bidlenz_default`, where another project has services
	# called `api` and `web` too. Docker's DNS answered with whichever it
	# liked: both `api` and `web` resolved into the 172.19 network, so every
	# page of seo.oryxenlabs.com served the other application and every
	# /api/* call returned 502 -- their API listens on 8787, so :8000 was
	# refused. Nothing here failed; the names simply stopped meaning us.
	#
	# It was found because Google rejected the OAuth verification, saying the
	# homepage and privacy policy were unresponsive. They were. That is the
	# only reason anybody looked, which is the part worth remembering: an
	# ambiguous name fails silently and completely.
	#
	# A container name cannot collide the way a service name can. The cost is
	# that renaming the compose project breaks these two lines, loudly, at
	# reload -- which is the failure we want.
	handle_path /api/* {
		reverse_proxy seo-autopilot-api-1:8000
	}

	handle {
		reverse_proxy seo-autopilot-web-1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---------------------------------------------------------------------------
# Cha-Ching relay (Oryxen Labs) -- the vhost for relay.oryxenlabs.com.
#
# This file is now the whole config, not a fragment to be appended. Deploy it
# by syncing `infra/caddy/`, then validate and reload inside the container --
# a reload does not restart it, so no vhost drops a connection:
#
#   docker exec seo-autopilot-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec seo-autopilot-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
#
# WHY THIS BLOCK EXISTS HERE. It was added by hand on 2026-09-02 with the
# migration off the codeArc box, and lost on 2026-09-08 when that Caddyfile was
# replaced wholesale by a copy that predated it. relay.oryxenlabs.com then
# served no certificate at all -- Caddy answered the TLS handshake with an
# internal-error alert -- and every phone reported "lost connection" until
# 2026-09-10. Nothing on the seo-autopilot side failed, so nothing showed it.
#
# That directory on the box is not a git checkout; it is deployed by copying
# files onto it. A copy that does not carry this block takes the relay off the
# air silently -- which is why every vhost the box serves now lives in this
# file, including BidLenz below. Editing prod by hand is what broke it, twice.
# `scripts/check_relay.sh` catches it happening.
#
# The relay is a HOST systemd service (chaching-relay on 0.0.0.0:8766), not a
# container, so Caddy reaches it across the Docker bridge gateway rather than
# by container name. ufw permits 8766 only from the Docker subnets.
# ---------------------------------------------------------------------------
relay.oryxenlabs.com {
	reverse_proxy 172.18.0.1:8766

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

bidlenz.oryxenlabs.com {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy bidlenz-api-1:8787
	}

	handle {
		reverse_proxy bidlenz-web-1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
