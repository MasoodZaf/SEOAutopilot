# Copy to .env.local for local development. Never commit real values.
APP_ENV=development
APP_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://seo_autopilot:seo_autopilot@localhost:5432/seo_autopilot
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# Authentication (configure an OIDC provider before enabling authenticated flows)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
CURSOR_SIGNING_KEY=replace-with-at-least-32-random-characters

# Local web pilot only. Rejected unless APP_ENV=development.
LOCAL_PILOT_AUTH_ENABLED=false
LOCAL_PILOT_AUTH_TOKEN=replace-with-at-least-32-random-characters
LOCAL_PILOT_TENANT_ID=019d0000-0000-7000-8000-00000000c001
LOCAL_PILOT_ACTOR_ID=019d0000-0000-7000-8000-00000000c002

# LLM adapter. OPENAI_API_KEY belongs only in .env.local or a secret manager.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
LLM_MAX_COST_MICROS_PER_RUN=250000

# Google connectors
GOOGLE_CONNECTORS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/connectors/oauth/callback
PAGESPEED_API_KEY=
SEARCH_QUERY_HASH_KEY=replace-with-a-separate-32-character-minimum-key
CONNECTOR_SECRET_BACKEND=disabled
# Local/test only: URL-safe base64 encoding of exactly 32 random bytes.
CONNECTOR_SECRET_ENCRYPTION_KEY=
CONNECTOR_SECRET_KEY_VERSION=local-v1
PAGESPEED_API_KEY=

# Deployment connectors
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
CMS_WEBHOOK_SECRET=

# Safety defaults
DEPLOYMENTS_ENABLED=false
AUTOPILOT_ENABLED=false
CRAWLER_MAX_PAGES=500
CRAWLER_MAX_DEPTH=10
CRAWLER_MAX_CONCURRENCY_PER_HOST=2
CRAWLER_REQUEST_DELAY_MS=500
CRAWLER_ALLOWED_PORTS=80,443
AUDIT_RETENTION_DAYS=365
